# Cloudflare : en-têtes de sécurité appliqués à toutes les pages.
# connect-src limite les serveurs que l'app a le DROIT de contacter.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://podo-api-37-60-238-12.sslip.io wss://podo-api-37-60-238-12.sslip.io; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
